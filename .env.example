# =====================================================
# SPARTA AI — Environment Variables
# تُضاف هذه القيم في Vercel: Settings → Environment Variables
# =====================================================

# مفتاح Groq (أساسي لتشغيل الدردشة وتحليل الصور)
GROQ_API_KEY=ضع_مفتاح_Groq_هنا

# النموذج النصي الافتراضي (اختياري)
GROQ_MODEL=openai/gpt-oss-120b

# نموذج الرؤية/الصور عبر Groq (اختياري)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# مفتاح MiniMax لتشغيل نموذج MiniMax M3
# اسم المتغير يجب أن يكون MINIMAX_API_KEY تمامًا في Vercel
# ملاحظة: إذا كان الحساب بلا رصيد يعيد MiniMax الخطأ 402 «insufficient balance (1008)».
# اشحن الرصيد من platform.minimax.io أو استخدم نموذج Groq لحين الشحن.
MINIMAX_API_KEY=ضع_مفتاح_MiniMax_هنا

# التحويل التلقائي إلى Groq عند نفاد رصيد MiniMax (مفعّل افتراضيًا)
# ضع القيمة false لتعطيله وإظهار رسالة الرصيد فقط
MINIMAX_GROQ_FALLBACK=true

# Seedance 2.5 عبر BytePlus ModelArk (اختياري — لإنشاء الفيديو من الاستوديو)
# يظل المفتاح على الخادم فقط ولا يوضع في JavaScript أو المتصفح.
# يقبل التكامل أيضًا الاسم الرسمي ARK_API_KEY بدلًا من SEEDANCE_API_KEY.
SEEDANCE_API_KEY=ضع_مفتاح_BytePlus_ModelArk_هنا
# ARK_API_KEY=ضع_مفتاح_BytePlus_ModelArk_هنا

# اختياري: رمز وصول مستقل لحماية زر إنشاء الفيديو في موقع عام.
# لا تضع مفتاح Seedance هنا؛ هذا الرمز فقط طبقة وصول لواجهة SPARTA.
SEEDANCE_ACCESS_CODE=

# حد إنشـاءات فيديو تقريبي لكل IP في الساعة (الحماية ذاكرية فقط في Serverless).
SEEDANCE_MAX_REQUESTS_PER_HOUR=10

# اختياري: تجاوز مُعرّف الموديل إذا حدّثته BytePlus (اللاحقة تتغير مع كل إصدار).
# الافتراضي: dreamina-seedance-2-5-260628
# SEEDANCE_MODEL=dreamina-seedance-2-5-260628

# اختياري: تغيير منطقة ModelArk. الافتراضي سنغافورة (ap-southeast).
# يجب أن ينتهي المسار بـ /api/v3 وإلا رُفض الطلب.
# SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# سر المالك لحماية رفع الملفات (api/upload.js)
OWNER_SECRET=ضع_سر_المالك_هنا

# كلمة مرور المالك لتسجيل الدخول (api/owner-login.js)
OWNER_PASSWORD=ضع_كلمة_مرور_المالك_هنا

# توكن Vercel Blob لتخزين شعار وخلفية الموقع (اختياري)
BLOB_READ_WRITE_TOKEN=

# إعدادات الموقع العامة بصيغة JSON (اختياري — api/settings.js)
TMD_SETTINGS=
