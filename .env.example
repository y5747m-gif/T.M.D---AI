# =====================================================
# T.M.D_AI_Pro — Environment Variables
# تُضاف هذه القيم في Vercel: Settings → Environment Variables
# =====================================================

# مفتاح Groq (أساسي لتشغيل الدردشة وتحليل الصور)
GROQ_API_KEY=ضع_مفتاح_Groq_هنا

# النموذج النصي الافتراضي (اختياري)
GROQ_MODEL=openai/gpt-oss-120b

# نموذج الرؤية/الصور عبر Groq (اختياري)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# مفتاح MiniMax لتشغيل نموذج MiniMax M3
# اسم المتغير يجب أن يكون MINIMAX_API_KEY تمامًا في Vercel
MINIMAX_API_KEY=ضع_مفتاح_MiniMax_هنا

# سر المالك لحماية رفع الملفات (api/upload.js)
OWNER_SECRET=ضع_سر_المالك_هنا

# كلمة مرور المالك لتسجيل الدخول (api/owner-login.js)
OWNER_PASSWORD=ضع_كلمة_مرور_المالك_هنا

# توكن Vercel Blob لتخزين شعار وخلفية الموقع (اختياري)
BLOB_READ_WRITE_TOKEN=

# إعدادات الموقع العامة بصيغة JSON (اختياري — api/settings.js)
TMD_SETTINGS=
