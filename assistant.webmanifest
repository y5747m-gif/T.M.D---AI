{
  "name": "Aso AI — آسو إي آي (الفقاعة الذكية)",
  "short_name": "آسو إي آي",
  "description": "فقاعة Aso AI (آسو إي آي) الشفافة على شاشة الهاتف مع إضاءة ملونة لحدود الشاشة وبث مباشر للشاشة.",
  "id": "/assistant.html",
  "start_url": "/assistant.html?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait-primary",
  "dir": "rtl",
  "lang": "ar",
  "background_color": "#060916",
  "theme_color": "#060916",
  "categories": [
    "productivity",
    "utilities",
    "education"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/images/aura-bubble-logo.svg",
      "sizes": "any",
